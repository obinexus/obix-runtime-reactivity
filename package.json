{
  "name": "obix-runtime-reactivity",
  "version": "0.5.0",
  "description": "The reactivity of OBIX's native runtime, its own: ref, computed, watch, effects with dependency tracking, batching, an ordered update queue and cleanup. No framework, no DOM. Phase 6 (docs/recovery/native-runtime.md).",
  "license": "MIT",
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {},
  "keywords": [
    "obix",
    "runtime",
    "reactivity",
    "ref",
    "computed",
    "watch",
    "native"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-runtime-reactivity.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-runtime-reactivity/issues"
  },
  "homepage": "https://github.com/obinexus/obix-runtime-reactivity#readme"
}
